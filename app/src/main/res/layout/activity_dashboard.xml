<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:gravity="center"
    tools:ignore="HardcodedText"
    android:orientation="vertical"
    android:padding="16dp">

<!--    Again the dark blue background from the logo would go well as the background colour
        Also the buttons being teal would be cool
        Maybe add the logo as an image above the buttons??
        Might need log out button here-->
    <Button
        android:id="@+id/btnAddHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Host"/>

    <Button
        android:id="@+id/btnAddStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Add Student"/>

    <Button
        android:id="@+id/btnManageBookings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Manage Bookings"/>

</LinearLayout>