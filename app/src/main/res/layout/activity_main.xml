<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sba_dark_navy"
    android:padding="16dp"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText">

    <!-- Top Navigation Bar: Return to Dashboard and Sign Out -->
    <Button
        android:id="@+id/ReturnBtn"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:backgroundTint="@color/sba_card_bg"
        android:text="Dashboard"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        app:cornerRadius="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/logout"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:backgroundTint="@color/sba_card_bg"
        android:text="Log Out"
        android:textColor="@color/sba_logo_coral"
        android:textSize="13sp"
        app:cornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/sba_logo_coral"
        app:strokeWidth="1dp" />

    <!-- Current User Authentication Status Tracker -->
    <TextView
        android:id="@+id/user_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ReturnBtn"
        tools:text="Logged in as: user@example.com" />

    <!-- Filter Control Panel Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFilterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/sba_card_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/user_details">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/hosts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filter Host Families"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Area Selection Spinner and Label -->
            <TextView
                android:id="@+id/AreaFilLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Area:"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerArea"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:background="@android:drawable/btn_dropdown"
                android:entries="@array/areas_array" />

            <!-- Bathroom Selection Spinner and Label -->
            <TextView
                android:id="@+id/BathroomFilLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Bathroom:"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerBathroom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:background="@android:drawable/btn_dropdown"
                android:entries="@array/bathroom_array" />

            <!-- Apply Filter Action Button -->
            <Button
                android:id="@+id/buttonFilter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/sba_teal_accent"
                android:text="Apply Filter"
                android:textColor="@color/sba_dark_navy"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- RecyclerView for Host Results List  -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/my_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardFilterContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>